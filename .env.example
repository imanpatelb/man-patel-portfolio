# Copy to .env.local for local `vercel dev`, and add the same vars in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.

# Required — get one free at https://resend.com (API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — where enquiries are delivered (defaults to mptraderx.capital@gmail.com)
CONTACT_TO=mptraderx.capital@gmail.com

# Optional — verified sender. Until you verify a domain in Resend, leave this
# as the default below (works only when CONTACT_TO is your Resend account email).
# CONTACT_FROM=Portfolio <hello@yourdomain.com>
CONTACT_FROM=Portfolio Site <onboarding@resend.dev>
